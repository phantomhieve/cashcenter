# Django environment variables example
# Copy this file to .env and fill the values

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Database settings
DB_NAME=cash-center
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Google Gemini AI Market Intelligence
# Required for Argon DAG reasoning and market insight generation
GEMINI_API_KEY=
# Model configuration: Use 'gemini-3.8-flash' (or alias 'flash') for development (cheap & fast)
# Use 'gemini-4-argon' (or alias 'argon') for production deep reasoning
GEMINI_MODEL=gemini-3.8-flash

