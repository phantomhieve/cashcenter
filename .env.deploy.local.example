# Copy to .env.deploy.local (gitignored). Used by scripts/test-deploy-ssh.sh only.
# Do NOT commit .env.deploy.local.

SSH_KEY_FILE=/path/to/deploy_private_key
DEPLOY_HOST=your.server.example
DEPLOY_USER=cashcenter-deploy
DEPLOY_APP_DIR=/home/your-app-user/cash-center
DEPLOY_SSH_PORT=22
DEPLOY_HEALTHCHECK_URL=https://your-public-site.example/
